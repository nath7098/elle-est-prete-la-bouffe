# Clé API Anthropic (https://console.anthropic.com/settings/keys) — obligatoire
ANTHROPIC_API_KEY=

# Optionnel : code d'accès demandé par l'appli avant tout appel à Claude.
# Recommandé dès que l'appli est en ligne, sinon n'importe qui peut consommer tes crédits.
NUXT_APP_PASSWORD=

# Optionnel : modèle Claude utilisé (par défaut claude-opus-5-5)
# NUXT_ANTHROPIC_MODEL=claude-opus-5-5
